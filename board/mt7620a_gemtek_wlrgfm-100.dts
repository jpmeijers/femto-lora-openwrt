#include "mt7620a.dtsi"

/ {
 compatible = "gemtek,wlrgfm-100", "ralink,mt7620a-soc";
 model = "Gemtek WLRGFM-100 (Femto)";
 memory@0 { device_type = "memory"; reg = <0x0 0x10000000>; };
 chosen { bootargs = "console=ttyS0,57600 root=/dev/ubiblock0_0 rootfstype=squashfs"; };
};

&palmbus {
 nand@810 {
  compatible = "mtk,mt7620-nand";
  reg = <0x810 0x100>;
  partitions {
   compatible = "fixed-partitions";
   #address-cells = <1>;
   #size-cells = <1>;
   partition@0 { label = "Bootloader"; reg = <0x0 0x80000>; read-only; };
   partition@80000 { label = "Config"; reg = <0x80000 0x80000>; read-only; };
   factory: partition@100000 { label = "Factory"; reg = <0x100000 0x40000>; read-only; };
   partition@140000 { label = "kernel"; reg = <0x140000 0x800000>; };
   partition@940000 { label = "ubi"; reg = <0x940000 0x1600000>; };
   partition@1f40000 { label = "firmware2"; reg = <0x1f40000 0x1e00000>; read-only; };
   partition@3d40000 { label = "stock_rootfs_data"; reg = <0x3d40000 0x1400000>; read-only; };
   partition@5140000 { label = "data"; reg = <0x5140000 0x14a00000>; read-only; };
   partition@19b40000 { label = "reserved"; reg = <0x19b40000 0x64c0000>; read-only; };
  };
 };
};

&factory {
 compatible = "nvmem-cells";
 #address-cells = <1>;
 #size-cells = <1>;
 macaddr_factory_4: macaddr@4 { reg = <0x4 0x6>; };
};

&ethernet {
 mediatek,portmap = "lllll";
 nvmem-cells = <&macaddr_factory_4>;
 nvmem-cell-names = "mac-address";
 /* Factory stores Wi-Fi MAC; vendor Ethernet MAC is one lower. */
 mac-address-increment = <(-1)>;
};
&gsw { mediatek,port4 = "ephy"; };
&wmac { status = "okay"; ralink,mtd-eeprom = <&factory 0>; };
&pcie { status = "disabled"; };
&gpio1 { status = "okay"; };
&gpio2 { status = "okay"; };
&spi0 {
 status = "okay";
 /* Match vendor SPICFG: idle low, both independent RX/TX edges falling. */
 ralink,rx-falling-edge;
 concentrator@0 {
  compatible = "semtech,sx1301";
  reg = <0>;
  spi-max-frequency = <4000000>;
 };
};
&spi1 { status = "disabled"; };
&sdhci { status = "disabled"; };
&ehci { status = "okay"; };
&ohci { status = "okay"; };

&state_default {
 gpio { groups = "rgmii1", "rgmii2"; function = "gpio"; };
};
