+static inline int
+ramtd_nand_writeoob(struct mtd_info *mtd, loff_t to,
+                    struct mtd_oob_ops *ops)
+{
+	struct ra_nand_chip *ra = mtd->priv;
+	int ret;
+
+	ret = nand_get_device(ra, FL_READING);
+	if (ret)
+		return ret;
+	ret = nand_do_write_ops(ra, to, ops);
+	nand_release_device(ra);
+
+	return ret;
+}
+
+static int
+ramtd_nand_block_isbad(struct mtd_info *mtd, loff_t offs)
+{
+	struct ra_nand_chip *ra = mtd->priv;
+	int ret;
+	if (offs < 0 || offs >= mtd->size)
+		return -EINVAL;
+	ret = nand_get_device(ra, FL_READING);
+	if (ret)
+		return ret;
+	ret = nand_block_checkbad(ra, offs);
+	nand_release_device(ra);
+	return ret;
+}
+
+static int
+ramtd_nand_block_markbad(struct mtd_info *mtd, loff_t ofs)
+{
+	struct ra_nand_chip *ra = mtd->priv;
+	int ret;
+
+	ra_dbg("%s: \n", __func__);
+	ret = nand_get_device(ra, FL_WRITING);
+	if (ret)
+		return ret;
+	ret = nand_block_markbad(ra, ofs);
+	nand_release_device(ra);
+
+	return ret;
+}
