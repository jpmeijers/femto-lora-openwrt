+#!/bin/sh
+cd /var/run/lorawan || exit 1
+. /lib/functions.sh
+config_load lorawan
+config_get protocol main protocol udp
+case "$protocol" in
+ basicstation)
+  export LORAGW_SPI_SPEED=4000000
+  exec /usr/sbin/femto-basicstation --home /var/run/lorawan --temp /var/run/lorawan --radio-init /usr/sbin/femto-lora-reset
+  ;;
+ udp) exec /usr/sbin/lora_pkt_fwd ;;
+ *) echo 'Unknown forwarder protocol' >&2; exit 1 ;;
+esac
