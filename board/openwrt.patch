+ let station = { station_conf: { routerid: eui, euiprefix: '::0', log_level: 'INFO', RADIO_INIT_WAIT: '5s' }, SX1301_conf: rf };
+ if (!writefile('/var/run/lorawan/station.conf', sprintf('%J\n', station)) ||
+     !writefile('/var/run/lorawan/tc.uri', uri + '\n') ||
+     !writefile('/var/run/lorawan/tc.trust', trust) ||
+     !writefile('/var/run/lorawan/tc.key', 'Authorization: Bearer ' + g.lns_key + '\r\n')) die('Cannot write Basic Station runtime files\n');
+ chmod('/var/run/lorawan/tc.key', 0o600);
+}
+else if ((g.protocol || 'udp') != 'udp') die('Unknown forwarder protocol\n');
diff --git a/package/utils/femto-lorawan/files/usr/sbin/femto-lora-reset b/package/utils/femto-lorawan/files/usr/sbin/femto-lora-reset
