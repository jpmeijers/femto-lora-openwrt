--- /dev/null
+++ b/package/utils/femto-lorawan/files/usr/sbin/femto-lora-config
@@ -0,0 +1,58 @@
+#!/usr/bin/ucode
+'use strict';
+import { readfile, writefile, popen, chmod } from 'fs';
+import { cursor } from 'uci';
+let u = cursor();
+let g = u.get_all('lorawan', 'main');
+let board_command = popen('/usr/sbin/femto-board-info', 'r');
+let board = board_command ? json(board_command.read('all')) : {};
+if (board_command) board_command.close();
+if (board.region_conflict || board.region == 'NON_EU') die('Unsupported or conflicting region: only EU hardware is supported\n');
+if (board.region != 'EU' && g.region != 'EU') die('Region unknown: verify the enclosure EU marking and select EU in LuCI\n');
+let c = json(g.advanced || readfile('/usr/share/lorawan/eu868.json'));
+let eui = g.gateway_id || board.eui || '';
+if (!g.advanced && length(board.tx_lut || []) == 16)
+ for (let i = 0; i < 16; i++) c.SX1301_conf['tx_lut_' + i] = board.tx_lut[i];
+if (type(c.SX1301_conf) != 'object' || type(c.gateway_conf) != 'object') die('Missing SX1301_conf or gateway_conf\n');
+if (!match(eui, /^[a-fA-F0-9]{16}$/)) die('Gateway EUI must contain 16 hexadecimal digits\n');
+c.gateway_conf.gateway_ID = eui;
+c.gateway_conf.server_address = g.server;
+c.gateway_conf.serv_port_up = +g.port_up;
+c.gateway_conf.serv_port_down = +g.port_down;
+c.gateway_conf.gps_tty_path = '';
+c.SX1301_conf.antenna_gain = +g.antenna_gain;
+c.SX1301_conf.radio_0.tx_enable = g.tx_enabled == '1';
+c.SX1301_conf.radio_1.tx_enable = false;
+c.SX1301_conf.radio_0.freq = +g.radio0_frequency;
+c.SX1301_conf.radio_1.freq = +g.radio1_frequency;
+c.SX1301_conf.radio_0.rssi_offset = +g.rssi_offset;
+c.SX1301_conf.radio_1.rssi_offset = +g.rssi_offset;
+if (!writefile('/var/run/lorawan/global_conf.json', sprintf('%J\n', c))) die('Cannot write runtime configuration\n');
+
+// Basic Station keeps local RF properties; the LNS supplies channel frequencies.
+if ((g.protocol || 'udp') == 'basicstation') {
+ let uri = g.lns_uri || 'wss://eu1.cloud.thethings.network:8887';
+ if (!match(uri, /^wss:\/\/[a-zA-Z0-9.-]+(:[0-9]+)?$/)) die('LNS must be a wss://hostname:port address without a path\n');
+ if (!match(g.lns_key || '', /^[A-Za-z0-9._=-]+$/)) die('Enter a gateway LNS API key in LuCI\n');
+ let trust = readfile('/etc/ssl/certs/ca-certificates.crt');
+ if (!trust) die('System CA bundle is unavailable\n');
+ let rf = { device: '/dev/spidev0.0', pps: false, lorawan_public: true, clksrc: c.SX1301_conf.clksrc, tx_gain_lut: [] };
+ for (let i = 0; i < 2; i++) {
+  let r = c.SX1301_conf['radio_' + i];
+  rf['radio_' + i] = { type: r.type, rssi_offset: r.rssi_offset, tx_enable: r.tx_enable, antenna_gain: +g.antenna_gain };
+ }
+ for (let i = 0; i < 16; i++) {
+  let row = c.SX1301_conf['tx_lut_' + i];
+  if (!row) continue;
+  push(rf.tx_gain_lut, { dig_gain: row.dig_gain, pa_gain: row.pa_gain, dac_gain: row.dac_gain ?? 3, mix_gain: row.mix_gain, rf_power: int(row.rf_power) });
+ }
+ if (!length(rf.tx_gain_lut)) die('Basic Station needs an EU TX gain table\n');
