+# SPDX-License-Identifier: GPL-2.0-only
+include $(TOPDIR)/rules.mk
+PKG_NAME:=femto-basicstation
+PKG_VERSION:=2.0.6
+PKG_RELEASE:=1
+PKG_SOURCE:=basicstation-$(PKG_VERSION).tar.gz
+PKG_SOURCE_URL:=https://codeload.github.com/lorabasics/basicstation/tar.gz/v$(PKG_VERSION)?
+PKG_HASH:=7e285de94bae1174b4c3496fc3ab15fe67c72f92c0693d2320bafc654a9dfb43
+PKG_BUILD_DIR:=$(BUILD_DIR)/femto-basicstation-$(PKG_VERSION)
+define PKG_UNPACK
+	mkdir -p $(PKG_BUILD_DIR)
+	tar -xf $(DL_DIR)/$(PKG_SOURCE) --strip-components=1 -C $(PKG_BUILD_DIR)
+endef
+PKG_LICENSE:=BSD-3-Clause
+PKG_LICENSE_FILES:=LICENSE hal/LICENSE
+PKG_BUILD_DEPENDS:=libloragw
+include $(INCLUDE_DIR)/package.mk
+include $(INCLUDE_DIR)/cmake.mk
+
+define Package/femto-basicstation
+ SECTION:=net
+ CATEGORY:=Network
+ TITLE:=SX1301 Basic Station for Gemtek Femto
+ DEPENDS:=+libmbedtls +libpthread +librt +ca-bundle +femto-lorawan
+ CONFLICTS:=basicstation
+endef
+
+define Build/Prepare
+	$(call Build/Prepare/Default)
+	mkdir -p $(PKG_BUILD_DIR)/hal
+	tar -xf $(DL_DIR)/lora-gateway-hal-5.0.1.tar.gz --strip-components=1 -C $(PKG_BUILD_DIR)/hal
+	$(PATCH) -d $(PKG_BUILD_DIR)/hal -p1 < $(PKG_BUILD_DIR)/deps/lgw/v5.0.1-linux.patch
+	$(PATCH) -d $(PKG_BUILD_DIR)/hal -p1 < ./half-duplex.patch
