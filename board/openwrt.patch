--- /dev/null
+++ b/package/utils/femto-lorawan/files/etc/uci-defaults/90-femto-network
@@ -0,0 +1,17 @@
+#!/bin/sh
+# Migrate the initial Ethernet-only port to a bridge for Wi-Fi access points.
+if [ "$(uci -q get network.lan.device)" = eth0 ] && ! uci -q get network.lan_bridge >/dev/null; then
+ uci set network.lan_bridge=device
+ uci set network.lan_bridge.name=br-lan
+ uci set network.lan_bridge.type=bridge
+ uci -q delete network.lan_bridge.ports
+ uci add_list network.lan_bridge.ports=eth0
+ uci set network.lan.device=br-lan
+ uci commit network
+fi
+# Expose DNS/DHCP controls while retaining the original no-DHCP-server default.
+if uci -q get dhcp.lan >/dev/null && [ -z "$(uci -q get dhcp.lan.ignore)" ]; then
+ uci set dhcp.lan.ignore=1
+ uci commit dhcp
+fi
+exit 0
