+/* SPDX-License-Identifier: GPL-2.0-only
+ * Read-only identity/region/calibration discovery from factory metadata.
+ * This reads the CRC-protected bootloader cache, NOT the live module EEPROM.
+ */
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+static int mtd_path(const char *name, char path[64]) {
+ FILE *f=fopen("/proc/mtd","r"); char line[256],label[80]; unsigned n,a,b;
+ if(!f)return -1;
+ while(fgets(line,sizeof line,f))
+  if(sscanf(line,"mtd%u: %x %x \"%79[^\"]\"",&n,&a,&b,label)==4 && !strcmp(name,label)) {
+   snprintf(path,64,"/dev/mtd%u",n);fclose(f);return 0;
+  }
+ fclose(f);return -1;
+}
+static uint32_t crc32(const unsigned char *p,size_t n) {
+ uint32_t c=~0u;while(n--){c^=*p++;for(int j=0;j<8;j++)c=(c>>1)^(0xedb88320u & (0u-(c&1)));}return ~c;
+}
+static uint32_t le32(const unsigned char *p) {return p[0]|((uint32_t)p[1]<<8)|((uint32_t)p[2]<<16)|((uint32_t)p[3]<<24);}
+static const char *env_get(const unsigned char *env,const char *key) {
+ size_t len=strlen(key),at=4;
+ while(at<4096 && env[at]) {
+  const unsigned char *end=memchr(env+at,0,4096-at);if(!end)return NULL;
+  if((size_t)(end-env-at)>len && !memcmp(env+at,key,len) && env[at+len]=='=')return (const char*)env+at+len+1;
+  at=(size_t)(end-env)+1;
+ }return NULL;
+}
+static int hex(int c){if(c>='0'&&c<='9')return c-'0';if(c>='a'&&c<='f')return c-'a'+10;if(c>='A'&&c<='F')return c-'A'+10;return -1;}
+static int useful(const unsigned char *p,size_t n){int zero=1,ff=1;for(size_t i=0;i<n;i++){zero&=p[i]==0;ff&=p[i]==255;}return !zero&&!ff;}
+int main(int argc,char **argv) {
+ char config[64]="",factory[64]="";const char *cp=NULL,*fp=NULL;
+ for(int i=1;i<argc;i++) {
+  if(!strcmp(argv[i],"--config") && i+1<argc)cp=argv[++i];
+  else if(!strcmp(argv[i],"--factory") && i+1<argc)fp=argv[++i];
+  else {fprintf(stderr,"usage: femto-board-info [--config Config-data.bin] [--factory Factory-data.bin]\n");return 2;}
+ }
+ if(!cp && !mtd_path("Config",config))cp=config;
+ if(!fp && !mtd_path("Factory",factory))fp=factory;
+ unsigned char env[4096],ee[128],mac[6];int valid=0,have_ee=0,have_mac=0,fd; size_t ee_len=0;
+ if(cp && (fd=open(cp,O_RDONLY))>=0){ssize_t n=pread(fd,env,sizeof env,0);close(fd);valid=n==sizeof env&&crc32(env+4,4092)==le32(env);}
+ if(fp && (fd=open(fp,O_RDONLY))>=0){have_mac=pread(fd,mac,6,4)==6&&useful(mac,6)&&!(mac[0]&1);close(fd);}
+ const char *country=valid?env_get(env,"lora_country_code"):NULL;
+ const char *s=valid?env_get(env,"lora_ee_cnt_0"):NULL;
+ if(s && strlen(s)>=18 && strlen(s)<=256 && !(strlen(s)%2)){ee_len=strlen(s)/2; memset(ee,255,sizeof ee); have_ee=1;for(size_t i=0;i<ee_len;i++){int a=hex(s[i*2]),b=hex(s[i*2+1]);if(a<0||b<0){have_ee=0;break;}ee[i]=(a<<4)|b;}}
+ char eui[17]="";const char *source="unavailable";
+ if(have_ee && useful(ee,8) && useful(ee+2,6)){for(int i=0;i<8;i++)snprintf(eui+i*2,3,"%02X",ee[i]);source="factory-eeprom-cache";}
+ else if(have_mac) {
+  /* Set the local bit; do not XOR it as in IPv6 modified-EUI-64 rules. */
+  snprintf(eui,sizeof eui,"%02X%02X%02XFFFE%02X%02X%02X",(mac[0]|2)&254,mac[1],mac[2],mac[3],mac[4],mac[5]);source="wifi-mac-local";
+ }
+ int band=have_ee?ee[8]:-1;int country_eu=country&&!strcmp(country,"EU");
+ int country_other=country&&(!strcmp(country,"US")||!strcmp(country,"TW")||!strcmp(country,"CN")||!strcmp(country,"AU")||!strcmp(country,"IN")||!strcmp(country,"JP")||!strcmp(country,"KR"));
+ int band_other=band==0||band==2;
+ const char *region=(country_other||band_other)?"NON_EU":(country_eu||band==1)?"EU":"UNKNOWN";
+ int conflict=(country_eu&&band_other)||(country_other&&band==1);
+ printf("{\"eui\":\"%s\",\"eui_source\":\"%s\",\"config_crc_valid\":%s,\"region\":\"%s\",\"region_source\":\"%s\",\"region_conflict\":%s,\"eeprom_band\":",eui,source,valid?"true":"false",region,valid?"bootloader-eeprom-cache":"unavailable",conflict?"true":"false");
+ if(band>=0)printf("%d",band);else printf("null");
+ int lut=have_ee&&ee_len>=80&&ee[14]<=3;
+ for(int i=0;lut&&i<16;i++){const unsigned char *p=ee+16+4*i;double power=(int8_t)p[3]/2.0;lut=p[0]<=3&&p[1]<=3&&p[2]>=8&&p[2]<=15&&power>=-30&&power<=40;}
+ printf(",\"tx_lut\":[");
+ if(lut)for(int i=0;i<16;i++){const unsigned char *p=ee+16+4*i;printf("%s{\"dig_gain\":%u,\"pa_gain\":%u,\"dac_gain\":%u,\"mix_gain\":%u,\"rf_power\":%.1f}",i?",":"",p[0],p[1],ee[14],p[2],(int8_t)p[3]/2.0);}
+ printf("]}\n");return 0;
+}
diff --git a/package/utils/femto-lorawan/src/probe.c b/package/utils/femto-lorawan/src/probe.c
new file mode 100644
index 0000000..d49dc7c
--- /dev/null
+++ b/package/utils/femto-lorawan/src/probe.c
@@ -0,0 +1,11 @@
+#include <stdio.h>
+#include <stdint.h>
+#include "loragw_reg.h"
+int main(void) {
+ int32_t version=0;
+ if(lgw_connect(0,129000)!=0) { puts("Concentrator connection failed"); return 1; }
+ int result=lgw_reg_r(LGW_VERSION,&version);
+ printf("SX1301 version: %d\n",version);
+ lgw_disconnect();
+ return result!=0 || version!=103;
+}
