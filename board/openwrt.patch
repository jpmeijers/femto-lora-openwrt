+#!/bin/sh /etc/rc.common
+USE_PROCD=1
+START=95
+STOP=10
+start_service() {
+ local enabled protocol
+ config_load lorawan
+ config_get_bool enabled main enabled 0
+ [ "$enabled" = 1 ] || return 0
+ config_get protocol main protocol udp
+ if [ "$protocol" = basicstation ] && [ ! -x /usr/sbin/femto-basicstation ]; then
+  logger -t lorawan 'Install femto-basicstation before selecting Basic Station'
+  return 1
+ fi
+ umask 077
+ chmod 600 /etc/config/lorawan
+ mkdir -p /var/run/lorawan
+ chmod 700 /var/run/lorawan
+ /usr/sbin/femto-lora-config || return 1
+ /usr/sbin/femto-lora-reset || return 1
+ procd_open_instance
+ procd_set_param command /usr/sbin/femto-lora-run
+ procd_set_param stdout 1
+ procd_set_param stderr 1
+ procd_set_param respawn 3600 5 3
+ procd_set_param file /etc/config/lorawan
+ procd_close_instance
+}
+service_triggers() {
+ procd_add_reload_trigger lorawan
+}
diff --git a/package/utils/femto-lorawan/files/etc/uci-defaults/90-femto-network b/package/utils/femto-lorawan/files/etc/uci-defaults/90-femto-network
new file mode 100755
